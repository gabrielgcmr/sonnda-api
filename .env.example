# .env.example
# Application
APP_ENV=dev
PORT=8080
# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
# Database
DATABASE_URL=postgresql://postgres.project:[password]@[name]:6543/postgres?sslmode=require
# Supabase
SUPABASE_PROJECT_URL=https://project.supabase.co
SUPABASE_JWT_ISSUER=https://project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_CAPTURES_BUCKET=captures
# Mesmo valor armazenado no Supabase Vault como capture_cleanup_token.
CAPTURE_CLEANUP_TOKEN=replace_with_at_least_32_random_characters
# Redis
REDIS_URL=rediss://default:[password]@[endpoint]:6379
# Professional activation (generate a bcrypt hash; never commit the password)
PROFESSIONAL_ACTIVATION_PASSWORD_HASH=
PROFESSIONAL_ACTIVATION_MAX_ATTEMPTS=5
PROFESSIONAL_ACTIVATION_WINDOW=15m
# Google Cloud Platform
GCP_PROJECT_ID=sonnda
GCP_PROJECT_NUMBER=project-number
#Storage
GCS_BUCKET=bucket-name
GCP_LOCATION=location
#Labs Extract
GCP_EXTRACT_LABS_PROCESSOR_ID=processor_id
# Gemini (etapa 2.1; ainda nao ativado nas rotas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30s
# Tempo total para OCR local de cada imagem, incluindo rotacoes e tratamentos.
OCR_TIMEOUT=60s
# Prazo da segunda tentativa de leitura com Document AI.
OCR_FALLBACK_TIMEOUT=60s
# Limite local em bytes UTF-8: texto + instrucao + schema, sem truncar.
GEMINI_MAX_INPUT_BYTES=131072
GEMINI_MAX_OUTPUT_TOKENS=8192
#Credentials
GOOGLE_APPLICATION_CREDENTIALS="/home/usr/to/credentials/sonnda-gcs.json"
# Deixe vazio quando usar arquivo em GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# CORS (opcional)
# Defaults automáticos por ambiente:
# - dev: http://localhost:5173,http://localhost:3000
# - staging: https://app-staging.sonnda.com.br
# - prod: https://app.sonnda.com.br
# Sobrescrever com variáveis se necessário (separado por vírgula):
# CORS_ORIGINS=https://app.sonnda.com.br,https://another-origin.com
# CORS_CREDENTIALS=true (padrão)
# CORS_MAX_AGE=86400 (em segundos)
